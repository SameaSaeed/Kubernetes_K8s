apiVersion: apps/v1
kind: Deployment
metadata:
  name: test-app
  namespace: vault
spec:
  replicas: 1
  selector:
    matchLabels:
      app: test-app
  template:
    metadata:
      labels:
        app: test-app
    spec:
      serviceAccountName: vault-auth
      containers:
      - name: test-app
        image: alpine:latest
        command: ["/bin/sh"]
        args: ["-c", "while true; do sleep 30; done"]
        env:
        - name: VAULT_ADDR
          value: "http://vault:8200"